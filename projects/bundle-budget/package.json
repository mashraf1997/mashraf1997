{
  "name": "@mirrororg/bundle-budget",
  "version": "1.0.0",
  "description": "Zero-dependency performance budgets for build output: raw, gzip and brotli sizes, baselines, Markdown reports for pull requests and CI exit codes.",
  "type": "module",
  "bin": { "bundle-budget": "./bin/bundle-budget.js" },
  "exports": "./src/index.js",
  "files": ["bin", "src"],
  "engines": { "node": ">=18.17" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node bin/bundle-budget.js test/fixtures/site --config test/fixtures/site/budget.json"
  },
  "keywords": ["performance", "budget", "bundle-size", "gzip", "brotli", "ci", "web-vitals"],
  "author": "Mohamed Ashraf <info@mirrororg.com> (https://mirrororg.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashraf1997/mashraf1997.git",
    "directory": "projects/bundle-budget"
  }
}
