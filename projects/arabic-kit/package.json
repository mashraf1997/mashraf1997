{
  "name": "@mirrororg/arabic-kit",
  "version": "1.0.0",
  "description": "Zero-dependency Arabic text toolkit: normalization, search matching, slugs, transliteration, digits, direction detection and number-to-words (tafqit).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["arabic", "rtl", "slug", "normalize", "tafqit", "transliteration", "i18n", "search"],
  "author": "Mohamed Ashraf <info@mirrororg.com> (https://mirrororg.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashraf1997/mashraf1997.git",
    "directory": "projects/arabic-kit"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
